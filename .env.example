# ---------- LINE ----------
# LIFF app ID (LINE Developers > your LINE Login channel > LIFF tab), e.g. 2001234567-AbCdEfGh
NEXT_PUBLIC_LIFF_ID=
# Optional. Channel ID of the LINE Login channel that owns the LIFF app.
# Leave empty: it's read from the LIFF ID prefix. If set, it must NOT be the Messaging API channel ID.
LINE_LOGIN_CHANNEL_ID=
# Your LINE Official Account basic ID
NEXT_PUBLIC_LINE_OA_ID=

# ---------- Cloudflare Turnstile ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Google Sheets (service account) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n sequences; they are converted at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Registrations
# Company dropdown source. Row 1 must have the headers Company_Name and Company_ID (any column order).
COMPANIES_TAB=Companies_DB
# Only if Companies_DB lives in a different spreadsheet; otherwise leave empty to use SHEET_ID.
COMPANIES_SHEET_ID=

# ---------- PDPA ----------
# Bump this whenever the privacy policy text changes
CONSENT_VERSION=pdpa-v1
NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy

# ---------- Browser test mode (local `npm run dev` only) ----------
# 1 = open http://localhost:3000/?preview=1 in any browser, no LINE account needed.
# Ignored in production builds (Vercel, `next start`), so it's safe to leave out there.
DEV_BROWSER_TEST=0
# Cloudflare's public test keys (always pass) if you want to see the widget locally:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
