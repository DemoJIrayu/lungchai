# ---------- LINE ----------
# LIFF app ID (LINE Developers > your LINE Login channel > LIFF tab), e.g. 2001234567-AbCdEfGh
NEXT_PUBLIC_LIFF_ID=
# Channel ID of the LINE Login channel that owns the LIFF app (used to verify ID tokens)
LINE_LOGIN_CHANNEL_ID=
# Your LINE Official Account basic ID
NEXT_PUBLIC_LINE_OA_ID=

# ---------- Cloudflare Turnstile ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Google Sheets (service account) ----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n sequences; they are converted at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Registrations

# ---------- PDPA ----------
# Bump this whenever the privacy policy text changes
CONSENT_VERSION=pdpa-v1
NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
